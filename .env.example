APP_ENV=development
APP_TIMEZONE=Asia/Singapore
APP_PUBLIC_URL=http://localhost:3000
APP_PUBLIC_HOST=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

LTA_DATAMALL_ACCOUNT_KEY=
ONEMAP_ACCESS_TOKEN=
ONEMAP_BASE_URL=https://www.onemap.gov.sg
DATA_GOV_SG_API_KEY=
NEA_WEATHER_BASE_URL=https://api-open.data.gov.sg/v2/real-time/api

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

POSTGRES_DB=mahjourney
POSTGRES_USER=mahjourney
POSTGRES_PASSWORD=replace-with-generated-secret
DATABASE_URL=postgresql+asyncpg://mahjourney:replace-with-generated-secret@db:5432/mahjourney
PERSISTENCE_ENABLED=false

# Operational data source: load orders/vehicles/drivers/depots from PostgreSQL
# (imported from the Singapore Logistics Excel workbook). Set to "synthetic" to
# use the built-in in-memory fixtures instead (no DB required).
DATA_SOURCE=database
MAX_STOPS_PER_VEHICLE=20
ROAD_OPTIMIZED_ROUTING=true

APP_SESSION_SECRET=replace-with-generated-secret
# Single shared admin/dispatcher login. Generate ADMIN_PASSWORD_HASH with:
#   docker compose exec api python -c "from mahjourney.auth import hash_password; print(hash_password('your-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_TTL_MINUTES=720
TELEGRAM_WEBHOOK_SECRET=replace-with-generated-secret
ENROLLMENT_TOKEN_PEPPER=replace-with-generated-secret
AUDIT_CHAIN_HMAC_KEY=replace-with-generated-secret
APPROVAL_ACTION_HMAC_KEY=replace-with-generated-secret

X401_ISSUER_PRIVATE_KEY_PATH=/run/secrets/x401_issuer_private.jwk
X401_TRUSTED_ISSUER=mahjourney-demo-issuer
X401_VERIFIER_AUDIENCE=mahjourney-dispatcher
X401_PROTOCOL_VERSION=0.1.0

LTA_INCIDENTS_POLL_SECONDS=120
LTA_VMS_POLL_SECONDS=120
LTA_SPEED_BANDS_POLL_SECONDS=300
LTA_TRAVEL_TIMES_POLL_SECONDS=300
LTA_INCIDENTS_STALE_SECONDS=360
LTA_TRAFFIC_STALE_SECONDS=900
NEA_RAINFALL_POLL_SECONDS=300
NEA_TWO_HOUR_FORECAST_POLL_SECONDS=1800
NEA_RAINFALL_STALE_SECONDS=900
NEA_FORECAST_STALE_SECONDS=3600
MARKOV_MIN_CONDITIONAL_TRANSITIONS=100
ORTOOLS_TIME_LIMIT_SECONDS=5
MONTE_CARLO_ONLINE_SAMPLES=1000
MONTE_CARLO_EVAL_SAMPLES=5000
CONVERSATION_RETENTION_DAYS=30
BERT_GUARD_ENABLED=false
MASCOT_ENABLED=false
LIVE_EXTERNAL_READ_TESTS=true
TELEGRAM_SEND_TESTS=false
ALLOW_PLAN_EXECUTION_IN_TESTS=false

# When false, delivery time windows are ignored during planning: orders can be
# served any time within the assigned vehicle/driver's working hours instead
# of a per-order window_start_minute/window_end_minute.
ENFORCE_DELIVERY_WINDOWS=true

# Embedded into the browser bundle during the frontend container build.
NEXT_PUBLIC_API_BASE_URL=/api/v1
